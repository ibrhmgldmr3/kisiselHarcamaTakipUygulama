<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expenseapp.controller.RegisterController"
      styleClass="auth-form">

    <Label text="CREATE ACCOUNT" styleClass="app-title"/>

    <VBox spacing="8" maxWidth="320">
        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField" onAction="#handleRegister"/>

        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" onAction="#handleRegister"/>

        <Label text="Confirm Password" styleClass="field-label"/>
        <PasswordField fx:id="confirmPasswordField" onAction="#handleRegister"/>

        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>

        <Button text="CREATE ACCOUNT" onAction="#handleRegister" defaultButton="true"
                styleClass="primary-button" maxWidth="Infinity"/>
    </VBox>

    <Label text="Already have an account?" styleClass="hint-label"/>
    <Hyperlink text="Login" onAction="#goToLogin"/>
</VBox>
