<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expenseapp.controller.LoginController"
      styleClass="auth-form">

    <Label text="EXPENSE TRACKER" styleClass="app-title"/>

    <VBox spacing="8" maxWidth="320">
        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField" onAction="#handleLogin"/>

        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" onAction="#handleLogin"/>

        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>

        <Button text="LOGIN" onAction="#handleLogin" defaultButton="true"
                styleClass="primary-button" maxWidth="Infinity"/>

        <Hyperlink text="Forgot password?" onAction="#goToForgotPassword"/>
    </VBox>

    <Label text="Don't have an account?" styleClass="hint-label"/>
    <Hyperlink text="Register" onAction="#goToRegister"/>
</VBox>
