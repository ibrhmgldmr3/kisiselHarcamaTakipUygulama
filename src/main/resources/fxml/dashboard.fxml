<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expenseapp.controller.DashboardController"
      styleClass="form" spacing="8">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Dashboard" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel"/>
        <Button text="Logout" onAction="#handleLogout"/>
    </HBox>

    <HBox spacing="8">
        <Button text="+ Harcama Ekle" onAction="#handleAdd"/>
        <Button fx:id="editButton" text="Düzenle" onAction="#handleEdit"/>
        <Button fx:id="deleteButton" text="Sil" onAction="#handleDelete"/>
    </HBox>

    <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Henüz harcama yok."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="Date"/>
            <TableColumn fx:id="descriptionColumn" text="Description"/>
            <TableColumn fx:id="categoryColumn" text="Category"/>
            <TableColumn fx:id="amountColumn" text="Amount" styleClass="amount-column"/>
            <TableColumn fx:id="currencyColumn" text="Currency"/>
            <TableColumn fx:id="amountTryColumn" text="TRY" styleClass="amount-column"/>
        </columns>
    </TableView>

    <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>
</VBox>
