<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expenseapp.controller.DashboardController">

    <HBox styleClass="header">
        <Label text="Personal Expense Tracker" styleClass="header-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel" styleClass="header-user"/>
        <Button text="Reports" onAction="#handleReports" styleClass="secondary-button"/>
        <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button"/>
    </HBox>

    <VBox styleClass="dashboard-content" VBox.vgrow="ALWAYS">
        <HBox spacing="16">
            <VBox styleClass="total-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="TOTAL INCOME" styleClass="total-caption"/>
                <Label fx:id="totalIncomeLabel" styleClass="total-amount"/>
            </VBox>
            <VBox styleClass="total-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="TOTAL SPENDING" styleClass="total-caption"/>
                <Label fx:id="totalLabel" styleClass="total-amount"/>
            </VBox>
            <VBox styleClass="total-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="NET BALANCE" styleClass="total-caption"/>
                <Label fx:id="netLabel" styleClass="total-amount"/>
            </VBox>
        </HBox>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button text="+ Add Expense" onAction="#handleAdd" styleClass="primary-button"/>
            <Button text="+ Add Income" onAction="#handleAddIncome" styleClass="primary-button"/>
            <Button fx:id="editButton" text="Edit" onAction="#handleEdit" styleClass="secondary-button"/>
            <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
            <Button text="Export CSV" onAction="#handleExport" styleClass="secondary-button"/>
        </HBox>

        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab fx:id="expenseTab" text="Expenses">
                <TableView fx:id="expenseTable">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No expenses yet."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date"/>
                        <TableColumn fx:id="descriptionColumn" text="Description"/>
                        <TableColumn fx:id="categoryColumn" text="Category"/>
                        <TableColumn fx:id="amountColumn" text="Amount" styleClass="amount-column"/>
                        <TableColumn fx:id="currencyColumn" text="Currency"/>
                        <TableColumn fx:id="amountTryColumn" text="TRY" styleClass="amount-column"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab fx:id="incomeTab" text="Income">
                <TableView fx:id="incomeTable">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No income yet."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="incomeDateColumn" text="Date"/>
                        <TableColumn fx:id="incomeDescriptionColumn" text="Description"/>
                        <TableColumn fx:id="incomeAmountColumn" text="Amount" styleClass="amount-column"/>
                        <TableColumn fx:id="incomeCurrencyColumn" text="Currency"/>
                        <TableColumn fx:id="incomeAmountTryColumn" text="TRY" styleClass="amount-column"/>
                    </columns>
                </TableView>
            </Tab>
        </TabPane>

        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>
    </VBox>
</VBox>
