<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.expenseapp.controller.ForgotPasswordController"
      styleClass="auth-form">

    <Label text="RESET PASSWORD" styleClass="app-title"/>

    <VBox spacing="8" maxWidth="320">
        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField" onAction="#handleContinue"/>

        <!-- 1. adım: kullanıcı adı girilip güvenlik sorusu getirilir -->
        <Button fx:id="continueButton" text="CONTINUE" onAction="#handleContinue"
                styleClass="primary-button" maxWidth="Infinity"/>

        <!-- 2. adım: güvenlik sorusu cevaplanıp yeni şifre belirlenir -->
        <VBox fx:id="resetBox" spacing="8" visible="false">
            <Label text="Security Question" styleClass="field-label"/>
            <Label fx:id="questionLabel" wrapText="true"/>

            <Label text="Security Answer" styleClass="field-label"/>
            <TextField fx:id="securityAnswerField" onAction="#handleReset"/>

            <Label text="New Password" styleClass="field-label"/>
            <PasswordField fx:id="newPasswordField" onAction="#handleReset"/>

            <Label text="Confirm New Password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" onAction="#handleReset"/>

            <Button text="RESET PASSWORD" onAction="#handleReset"
                    styleClass="primary-button" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>
    </VBox>

    <Label text="Remembered your password?" styleClass="hint-label"/>
    <Hyperlink text="Login" onAction="#goToLogin"/>
</VBox>
